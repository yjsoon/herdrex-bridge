[Unit]
Description=Mirror hc terminals as Rex windows
# Start after your own Rex server unit, if you have one named rex.service; harmless if not.
After=rex.service

[Service]
# %h is the user's home directory. See README.md for installation.
# Make sure the hc core is up first. It does nothing if the core is already running,
# and the leading "-" lets the bridge start anyway if this fails.
ExecStartPre=-/usr/bin/env hc server start
# -I makes Python ignore PYTHON* variables and the current directory.
ExecStart=/usr/bin/env python3 -I %h/.local/bin/herdrex-bridge
# hc and rex are usually installed in ~/.local/bin, which systemd does not put on PATH.
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin
Restart=on-failure
RestartSec=5
# Exit 78 means hc or rex is missing from PATH; restarting would just loop.
RestartPreventExitStatus=78

[Install]
WantedBy=default.target
